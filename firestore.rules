rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection check document (contains no sensitive data)
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }
    function isValidHubId(val) {
      return val in ['marketing', 'dental_career', 'knowledge'];
    }
    function isValidOptionalDateKey(val) {
      return val is string && (val.size() == 0 || val.matches('^\\d{4}-\\d{2}-\\d{2}$'));
    }
    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && isValidStr(data.displayName, 0, 120)
        && isValidStr(data.email, 3, 200)
        && (!('photoURL' in data) || isValidStr(data.photoURL, 0, 600))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuarter(data, userId, quarterId) {
      return data.keys().hasAll(['id', 'ownerId', 'number', 'title', 'subtitle', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'number', 'title', 'subtitle', 'updatedAt'])
        && data.id == quarterId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.number is int && data.number >= 1 && data.number <= 20
        && isValidStr(data.title, 1, 200)
        && isValidStr(data.subtitle, 0, 300)
        && data.updatedAt is timestamp;
    }

    function isValidTrackObj(t) {
      return t is map
        && t.keys().hasAll(['title', 'author', 'format', 'domainId', 'pace', 'focus'])
        && t.keys().hasOnly(['title', 'author', 'format', 'domainId', 'pace', 'focus'])
        && isValidStr(t.title, 0, 300)
        && isValidStr(t.author, 0, 200)
        && isValidStr(t.format, 1, 60)
        && isValidStr(t.domainId, 1, 128)
        && isValidStr(t.pace, 0, 300)
        && isValidStr(t.focus, 0, 500);
    }

    function isValidActivitiesObj(a) {
      return a is map
        && a.keys().hasAll(['reading', 'listening', 'summarizing', 'discussing'])
        && a.keys().hasOnly(['reading', 'listening', 'summarizing', 'discussing'])
        && a.reading is bool
        && a.listening is bool
        && a.summarizing is bool
        && a.discussing is bool;
    }

    function isValidMonth(data, userId, monthDocId) {
      return data.keys().hasAll([
          'id', 'docId', 'ownerId', 'quarter', 'quarterTitle', 'theme',
          'foundational', 'exploratory', 'courseId', 'discussionPrompt',
          'applicationTask', 'activities', 'status', 'notes', 'tasks', 'resources', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'docId', 'ownerId', 'hubId', 'quarter', 'quarterTitle', 'theme',
          'foundational', 'exploratory', 'courseId', 'discussionPrompt',
          'applicationTask', 'activities', 'status', 'notes', 'tasks', 'resources',
          'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
          'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey', 'updatedAt'
        ])
        && data.docId == monthDocId
        && isValidId(data.docId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (!('hubId' in data) || isValidHubId(data.hubId))
        && data.id is int && data.id >= 1 && data.id <= 100
        && data.quarter is int && data.quarter >= 1 && data.quarter <= 20
        && isValidStr(data.quarterTitle, 1, 200)
        && isValidStr(data.theme, 1, 250)
        && isValidTrackObj(data.foundational)
        && isValidTrackObj(data.exploratory)
        && data.courseId is int && data.courseId >= 0 && data.courseId <= 1000
        && isValidStr(data.discussionPrompt, 0, 1000)
        && isValidStr(data.applicationTask, 0, 1000)
        && isValidActivitiesObj(data.activities)
        && data.status in ['not_started', 'in_progress', 'completed']
        && isValidStr(data.notes, 0, 20000)
        && data.tasks is list && data.tasks.size() <= 50
        && (data.tasks.size() == 0 || (data.tasks[0] is map && data.tasks[0].keys().hasAll(['id', 'text', 'track', 'done'])))
        && data.resources is list && data.resources.size() <= 30
        && (data.resources.size() == 0 || (data.resources[0] is map && data.resources[0].keys().hasAll(['id', 'title', 'type'])))
        && (!('readingModes' in data) || (data.readingModes is list && data.readingModes.size() <= 5))
        && (!('learningMethods' in data) || (data.learningMethods is list && data.learningMethods.size() <= 15))
        && (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000))
        && (!('listenCount' in data) || (data.listenCount is int && data.listenCount >= 0 && data.listenCount <= 10000))
        && (!('repetitionStage' in data) || (data.repetitionStage is int && data.repetitionStage >= 0 && data.repetitionStage <= 10))
        && (!('nextReviewDateKey' in data) || isValidOptionalDateKey(data.nextReviewDateKey))
        && (!('lastReviewedDateKey' in data) || isValidOptionalDateKey(data.lastReviewedDateKey))
        && data.updatedAt is timestamp;
    }

    function isValidDomain(data, userId, domainId) {
      return data.keys().hasAll(['id', 'ownerId', 'order', 'title', 'subtitle', 'purpose', 'thinkers', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'hubId', 'order', 'title', 'subtitle', 'purpose', 'thinkers', 'updatedAt'])
        && data.id == domainId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (!('hubId' in data) || isValidHubId(data.hubId))
        && data.order is int && data.order >= 0 && data.order <= 100
        && isValidStr(data.title, 1, 200)
        && isValidStr(data.subtitle, 0, 300)
        && isValidStr(data.purpose, 0, 1000)
        && data.thinkers is list && data.thinkers.size() <= 30
        && (data.thinkers.size() == 0 || (data.thinkers[0] is map && data.thinkers[0].keys().hasAll(['name', 'role', 'keyWorks', 'contribution'])))
        && data.updatedAt is timestamp;
    }

    function isValidCourse(data, userId, courseDocId) {
      return data.keys().hasAll([
          'id', 'docId', 'ownerId', 'title', 'category', 'linkedMonths',
          'complementaryBook', 'bookAuthor', 'applicationMilestone', 'completed',
          'resources', 'tasks', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'docId', 'ownerId', 'hubId', 'title', 'category',
          'instructor', 'platform', 'durationLabel', 'startDate', 'targetDate',
          'progressPct', 'notes', 'linkedMonths', 'complementaryBook', 'bookAuthor',
          'applicationMilestone', 'completed', 'resources', 'tasks',
          'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
          'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey', 'updatedAt'
        ])
        && data.docId == courseDocId
        && isValidId(data.docId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (!('hubId' in data) || isValidHubId(data.hubId))
        && data.id is int && data.id >= 1 && data.id <= 1000
        && isValidStr(data.title, 1, 250)
        && isValidStr(data.category, 0, 120)
        && (!('instructor' in data) || isValidStr(data.instructor, 0, 200))
        && (!('platform' in data) || isValidStr(data.platform, 0, 200))
        && (!('durationLabel' in data) || isValidStr(data.durationLabel, 0, 120))
        && (!('startDate' in data) || isValidStr(data.startDate, 0, 20))
        && (!('targetDate' in data) || isValidStr(data.targetDate, 0, 20))
        && (!('progressPct' in data) || (data.progressPct is int && data.progressPct >= 0 && data.progressPct <= 100))
        && (!('notes' in data) || isValidStr(data.notes, 0, 20000))
        && data.linkedMonths is list && data.linkedMonths.size() <= 24
        && (data.linkedMonths.size() == 0 || data.linkedMonths[0] is int)
        && isValidStr(data.complementaryBook, 0, 300)
        && isValidStr(data.bookAuthor, 0, 250)
        && isValidStr(data.applicationMilestone, 0, 1000)
        && data.completed is bool
        && data.resources is list && data.resources.size() <= 30
        && (data.resources.size() == 0 || (data.resources[0] is map && data.resources[0].keys().hasAll(['id', 'title', 'type'])))
        && data.tasks is list && data.tasks.size() <= 50
        && (data.tasks.size() == 0 || (data.tasks[0] is map && data.tasks[0].keys().hasAll(['id', 'text', 'track', 'done'])))
        && (!('readingModes' in data) || (data.readingModes is list && data.readingModes.size() <= 5))
        && (!('learningMethods' in data) || (data.learningMethods is list && data.learningMethods.size() <= 15))
        && (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000))
        && (!('listenCount' in data) || (data.listenCount is int && data.listenCount >= 0 && data.listenCount <= 10000))
        && (!('repetitionStage' in data) || (data.repetitionStage is int && data.repetitionStage >= 0 && data.repetitionStage <= 10))
        && (!('nextReviewDateKey' in data) || isValidOptionalDateKey(data.nextReviewDateKey))
        && (!('lastReviewedDateKey' in data) || isValidOptionalDateKey(data.lastReviewedDateKey))
        && data.updatedAt is timestamp;
    }

    function isValidBookNote(data, userId, noteId) {
      return data.keys().hasAll(['id', 'ownerId', 'bookTitle', 'author', 'progressMarker', 'content', 'quotes', 'updatedAtLabel', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'hubId', 'noteType', 'bookTitle', 'author',
          'courseId', 'courseTitle', 'lectureTitle', 'categoryLabel',
          'progressMarker', 'content', 'quotes', 'updatedAtLabel',
          'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
          'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey', 'updatedAt'
        ])
        && data.id == noteId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (!('hubId' in data) || isValidHubId(data.hubId))
        && (!('noteType' in data) || data.noteType in ['book', 'course_lecture', 'general'])
        && isValidStr(data.bookTitle, 1, 300)
        && isValidStr(data.author, 0, 200)
        && (!('courseId' in data) || (data.courseId is int && data.courseId >= 0 && data.courseId <= 1000))
        && (!('courseTitle' in data) || isValidStr(data.courseTitle, 0, 250))
        && (!('lectureTitle' in data) || isValidStr(data.lectureTitle, 0, 250))
        && (!('categoryLabel' in data) || isValidStr(data.categoryLabel, 0, 120))
        && isValidStr(data.progressMarker, 0, 200)
        && isValidStr(data.content, 0, 40000)
        && isValidStr(data.quotes, 0, 10000)
        && isValidStr(data.updatedAtLabel, 0, 100)
        && (!('readingModes' in data) || (data.readingModes is list && data.readingModes.size() <= 5))
        && (!('learningMethods' in data) || (data.learningMethods is list && data.learningMethods.size() <= 15))
        && (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000))
        && (!('listenCount' in data) || (data.listenCount is int && data.listenCount >= 0 && data.listenCount <= 10000))
        && (!('repetitionStage' in data) || (data.repetitionStage is int && data.repetitionStage >= 0 && data.repetitionStage <= 10))
        && (!('nextReviewDateKey' in data) || isValidOptionalDateKey(data.nextReviewDateKey))
        && (!('lastReviewedDateKey' in data) || isValidOptionalDateKey(data.lastReviewedDateKey))
        && data.updatedAt is timestamp;
    }

    function isValidCustomCategory(data, userId, categoryId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'description', 'color', 'createdAtLabel', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'hubId', 'title', 'description', 'color', 'createdAtLabel', 'updatedAt'])
        && data.id == categoryId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && (!('hubId' in data) || data.hubId in ['marketing', 'dental_career', 'knowledge', 'all'])
        && isValidStr(data.title, 1, 120)
        && isValidStr(data.description, 0, 300)
        && data.color in ['navy', 'emerald', 'amber', 'slate']
        && isValidStr(data.createdAtLabel, 0, 100)
        && data.updatedAt is timestamp;
    }

    function isValidHistoryEntry(data, userId, entryId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'actionType', 'title', 'detail',
          'targetTab', 'timestampLabel', 'createdAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'actionType', 'title', 'detail',
          'targetTab', 'targetNoteId', 'targetMonthId', 'targetCourseId',
          'timestampLabel', 'createdAtMs', 'updatedAt'
        ])
        && data.id == entryId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.actionType in ['note', 'voice', 'task', 'course', 'domain', 'month']
        && isValidStr(data.title, 1, 200)
        && isValidStr(data.detail, 0, 400)
        && data.targetTab in ['overview', 'plan', 'domains', 'courses', 'journal', 'calendar', 'paths', 'library', 'tasks']
        && (!('targetNoteId' in data) || isValidStr(data.targetNoteId, 0, 128))
        && (!('targetMonthId' in data) || (data.targetMonthId is int && data.targetMonthId >= 0 && data.targetMonthId <= 1000))
        && (!('targetCourseId' in data) || (data.targetCourseId is int && data.targetCourseId >= 0 && data.targetCourseId <= 1000))
        && isValidStr(data.timestampLabel, 0, 100)
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data, userId, prefId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'noteFontSize', 'noteHighlightColor', 'notePaperTone',
          'autoAddTimestampOnVoice', 'voiceDialect', 'voiceInsertMode',
          'readAloudVoice', 'readAloudSpeed', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'noteFontSize', 'noteHighlightColor', 'notePaperTone',
          'autoAddTimestampOnVoice', 'voiceDialect', 'voiceInsertMode',
          'readAloudVoice', 'readAloudSpeed', 'showExcelExport', 'hubCategories', 'updatedAt'
        ])
        && data.id == prefId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.noteFontSize in ['sm', 'base', 'lg']
        && data.noteHighlightColor in ['amber', 'emerald', 'sky', 'rose']
        && data.notePaperTone in ['clean', 'warm', 'slate']
        && data.autoAddTimestampOnVoice is bool
        && data.voiceDialect in ['standard_arabic', 'egyptian_arabic', 'bilingual']
        && data.voiceInsertMode in ['append_paragraph', 'append_bullet', 'append_quote']
        && data.readAloudVoice in ['Kore', 'Puck', 'Charon', 'Fenrir', 'Zephyr']
        && data.readAloudSpeed in ['normal', 'calm']
        && (!('showExcelExport' in data) || data.showExcelExport is bool)
        && (!('hubCategories' in data) || data.hubCategories is map)
        && data.updatedAt is timestamp;
    }

    function isValidReflection(data, userId, reflectionId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'content', 'moodTag',
          'pinned', 'createdAtLabel', 'createdAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'content', 'moodTag',
          'pinned', 'createdAtLabel', 'createdAtMs', 'updatedAt'
        ])
        && data.id == reflectionId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.title, 0, 200)
        && isValidStr(data.content, 1, 10000)
        && data.moodTag in ['تأمل', 'فكرة', 'امتنان', 'هدف']
        && data.pinned is bool
        && isValidStr(data.createdAtLabel, 0, 100)
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEvent(data, userId, eventId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'dateKey', 'timeSlot', 'title',
          'notes', 'category', 'color', 'done', 'linkedTaskText', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'dateKey', 'timeSlot', 'title',
          'notes', 'category', 'color', 'done', 'linkedTaskText', 'updatedAt'
        ])
        && data.id == eventId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && isValidStr(data.timeSlot, 0, 20)
        && isValidStr(data.title, 1, 200)
        && isValidStr(data.notes, 0, 2000)
        && data.category in ['شخصي', 'دراسة', 'موعد', 'مراجعة', 'قراءة']
        && data.color in ['navy', 'emerald', 'amber', 'rose']
        && data.done is bool
        && isValidStr(data.linkedTaskText, 0, 300)
        && data.updatedAt is timestamp;
    }

    function isValidLearningPath(data, userId, pathId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'hubId', 'status', 'progressPct',
          'stages', 'linkedCourseIds', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'hubId', 'categoryLabel',
          'objectives', 'currentLevel', 'targetLevel', 'startDate', 'expectedCompletionDate',
          'progressPct', 'status', 'stages', 'linkedCourseIds',
          'readingModes', 'learningMethods', 'reviewCount', 'listenCount', 'updatedAt'
        ])
        && data.id == pathId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.title, 1, 250)
        && (!('description' in data) || isValidStr(data.description, 0, 2000))
        && isValidHubId(data.hubId)
        && (!('categoryLabel' in data) || isValidStr(data.categoryLabel, 0, 120))
        && (!('objectives' in data) || isValidStr(data.objectives, 0, 2000))
        && (!('currentLevel' in data) || isValidStr(data.currentLevel, 0, 120))
        && (!('targetLevel' in data) || isValidStr(data.targetLevel, 0, 120))
        && (!('startDate' in data) || isValidStr(data.startDate, 0, 20))
        && (!('expectedCompletionDate' in data) || isValidStr(data.expectedCompletionDate, 0, 20))
        && data.progressPct is int && data.progressPct >= 0 && data.progressPct <= 100
        && data.status in ['planned', 'in_progress', 'completed']
        && data.stages is list && data.stages.size() <= 40
        && data.linkedCourseIds is list && data.linkedCourseIds.size() <= 30
        && (!('readingModes' in data) || (data.readingModes is list && data.readingModes.size() <= 5))
        && (!('learningMethods' in data) || (data.learningMethods is list && data.learningMethods.size() <= 15))
        && (!('reviewCount' in data) || (data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000))
        && (!('listenCount' in data) || (data.listenCount is int && data.listenCount >= 0 && data.listenCount <= 10000))
        && data.updatedAt is timestamp;
    }

    function isValidReadingItem(data, userId, itemId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'title', 'hubId', 'itemType', 'status',
          'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
          'repetitionStage', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'author', 'hubId', 'categoryLabel', 'itemType',
          'status', 'currentPage', 'totalPages', 'takeaways',
          'attachmentName', 'attachmentResourceId', 'storagePath', 'downloadUrl', 'externalUrl',
          'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
          'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey',
          'updatedAtLabel', 'updatedAt'
        ])
        && data.id == itemId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.title, 1, 300)
        && (!('author' in data) || isValidStr(data.author, 0, 200))
        && isValidHubId(data.hubId)
        && (!('categoryLabel' in data) || isValidStr(data.categoryLabel, 0, 120))
        && data.itemType in ['كتاب', 'مقال', 'بحث', 'ورقة علمية', 'ملف PDF', 'ملخص']
        && data.status in ['to_read', 'reading', 'completed']
        && (!('currentPage' in data) || (data.currentPage is int && data.currentPage >= 0 && data.currentPage <= 50000))
        && (!('totalPages' in data) || (data.totalPages is int && data.totalPages >= 0 && data.totalPages <= 50000))
        && (!('takeaways' in data) || isValidStr(data.takeaways, 0, 20000))
        && (!('attachmentName' in data) || isValidStr(data.attachmentName, 0, 200))
        && (!('attachmentResourceId' in data) || isValidStr(data.attachmentResourceId, 0, 128))
        && (!('storagePath' in data) || isValidStr(data.storagePath, 0, 400))
        && (!('downloadUrl' in data) || isValidStr(data.downloadUrl, 0, 1200))
        && (!('externalUrl' in data) || isValidStr(data.externalUrl, 0, 800))
        && data.readingModes is list && data.readingModes.size() <= 5
        && data.learningMethods is list && data.learningMethods.size() <= 15
        && data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 10000
        && data.listenCount is int && data.listenCount >= 0 && data.listenCount <= 10000
        && data.repetitionStage is int && data.repetitionStage >= 0 && data.repetitionStage <= 10
        && (!('nextReviewDateKey' in data) || isValidOptionalDateKey(data.nextReviewDateKey))
        && (!('lastReviewedDateKey' in data) || isValidOptionalDateKey(data.lastReviewedDateKey))
        && (!('updatedAtLabel' in data) || isValidStr(data.updatedAtLabel, 0, 100))
        && data.updatedAt is timestamp;
    }

    function isValidPracticalProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'hubId', 'status', 'progressPct', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'hubId', 'categoryLabel',
          'objectives', 'status', 'progressPct', 'deliverables',
          'startDate', 'targetDate', 'linkedCourseId', 'notes', 'updatedAt'
        ])
        && data.id == projectId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.title, 1, 250)
        && (!('description' in data) || isValidStr(data.description, 0, 3000))
        && isValidHubId(data.hubId)
        && (!('categoryLabel' in data) || isValidStr(data.categoryLabel, 0, 120))
        && (!('objectives' in data) || isValidStr(data.objectives, 0, 2000))
        && data.status in ['planned', 'in_progress', 'completed']
        && data.progressPct is int && data.progressPct >= 0 && data.progressPct <= 100
        && (!('deliverables' in data) || isValidStr(data.deliverables, 0, 2000))
        && (!('startDate' in data) || isValidStr(data.startDate, 0, 20))
        && (!('targetDate' in data) || isValidStr(data.targetDate, 0, 20))
        && (!('linkedCourseId' in data) || (data.linkedCourseId is int && data.linkedCourseId >= 0 && data.linkedCourseId <= 1000))
        && (!('notes' in data) || isValidStr(data.notes, 0, 10000))
        && data.updatedAt is timestamp;
    }

    function isValidUnifiedTask(data, userId, taskId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'hubId', 'priority', 'status', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'hubId', 'categoryLabel',
          'priority', 'status', 'dueDate', 'linkedLabel', 'updatedAt'
        ])
        && data.id == taskId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.title, 1, 300)
        && (!('description' in data) || isValidStr(data.description, 0, 2000))
        && isValidHubId(data.hubId)
        && (!('categoryLabel' in data) || isValidStr(data.categoryLabel, 0, 120))
        && data.priority in ['low', 'medium', 'high']
        && data.status in ['todo', 'in_progress', 'done']
        && (!('dueDate' in data) || isValidOptionalDateKey(data.dueDate))
        && (!('linkedLabel' in data) || isValidStr(data.linkedLabel, 0, 200))
        && data.updatedAt is timestamp;
    }

    function isValidImageAttachment(data, userId, imageId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'scopeKey', 'name', 'mimeType',
          'sizeKb', 'createdAtMs', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'scopeKey', 'name', 'mimeType', 'sizeKb',
          'caption', 'createdAtMs', 'dataUrl', 'storagePath', 'downloadUrl', 'updatedAt'
        ])
        && data.id == imageId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.scopeKey, 1, 128)
        && isValidStr(data.name, 1, 200)
        && isValidStr(data.mimeType, 1, 80)
        && data.sizeKb is int && data.sizeKb >= 0 && data.sizeKb <= 20000
        && (!('caption' in data) || isValidStr(data.caption, 0, 500))
        && data.createdAtMs is int && data.createdAtMs >= 0
        && (!('dataUrl' in data) || isValidStr(data.dataUrl, 0, 900000))
        && (!('storagePath' in data) || isValidStr(data.storagePath, 0, 400))
        && (!('downloadUrl' in data) || isValidStr(data.downloadUrl, 0, 1200))
        && data.updatedAt is timestamp;
    }

    function isValidFileAttachment(data, userId, attachmentId) {
      return data.keys().hasAll([
          'id', 'ownerId', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'updatedAt'
        ])
        && data.id == attachmentId
        && isValidId(data.id)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidStr(data.fileName, 1, 200)
        && isValidStr(data.mimeType, 1, 120)
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 900000
        && isValidStr(data.dataUrl, 1, 900000)
        && data.updatedAt is timestamp;
    }

    // --- User Profile Document (PII Isolated to Owner) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if false;

      // --- Quarters ---
      match /quarters/{quarterId} {
        allow get: if isValidId(userId) && isValidId(quarterId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(quarterId)
          && isOwner(userId) && isVerifiedUser()
          && isValidQuarter(incoming(), userId, quarterId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(quarterId)
          && isOwner(userId) && isVerifiedUser()
          && isValidQuarter(incoming(), userId, quarterId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['number', 'title', 'subtitle', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(quarterId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Months ---
      match /months/{monthId} {
        allow get: if isValidId(userId) && isValidId(monthId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(monthId)
          && isOwner(userId) && isVerifiedUser()
          && isValidMonth(incoming(), userId, monthId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(monthId)
          && isOwner(userId) && isVerifiedUser()
          && isValidMonth(incoming(), userId, monthId)
          && incoming().docId == existing().docId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'hubId', 'quarter', 'quarterTitle', 'theme', 'foundational', 'exploratory',
            'courseId', 'discussionPrompt', 'applicationTask', 'activities',
            'status', 'notes', 'tasks', 'resources',
            'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
            'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(monthId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Domains ---
      match /domains/{domainId} {
        allow get: if isValidId(userId) && isValidId(domainId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(domainId)
          && isOwner(userId) && isVerifiedUser()
          && isValidDomain(incoming(), userId, domainId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(domainId)
          && isOwner(userId) && isVerifiedUser()
          && isValidDomain(incoming(), userId, domainId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'hubId', 'order', 'title', 'subtitle', 'purpose', 'thinkers', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(domainId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Courses ---
      match /courses/{courseId} {
        allow get: if isValidId(userId) && isValidId(courseId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(courseId)
          && isOwner(userId) && isVerifiedUser()
          && isValidCourse(incoming(), userId, courseId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(courseId)
          && isOwner(userId) && isVerifiedUser()
          && isValidCourse(incoming(), userId, courseId)
          && incoming().docId == existing().docId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'id', 'hubId', 'title', 'category', 'instructor', 'platform', 'durationLabel',
            'startDate', 'targetDate', 'progressPct', 'notes', 'linkedMonths',
            'complementaryBook', 'bookAuthor', 'applicationMilestone', 'completed',
            'resources', 'tasks', 'readingModes', 'learningMethods', 'reviewCount',
            'listenCount', 'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(courseId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Book & Lecture Notes ---
      match /bookNotes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(noteId)
          && isOwner(userId) && isVerifiedUser()
          && isValidBookNote(incoming(), userId, noteId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(noteId)
          && isOwner(userId) && isVerifiedUser()
          && isValidBookNote(incoming(), userId, noteId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'hubId', 'noteType', 'bookTitle', 'author', 'courseId', 'courseTitle',
            'lectureTitle', 'categoryLabel', 'progressMarker', 'content',
            'quotes', 'updatedAtLabel', 'readingModes', 'learningMethods',
            'reviewCount', 'listenCount', 'repetitionStage', 'nextReviewDateKey',
            'lastReviewedDateKey', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Personalized Categories ---
      match /customCategories/{categoryId} {
        allow get: if isValidId(userId) && isValidId(categoryId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(categoryId)
          && isOwner(userId) && isVerifiedUser()
          && isValidCustomCategory(incoming(), userId, categoryId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(categoryId)
          && isOwner(userId) && isVerifiedUser()
          && isValidCustomCategory(incoming(), userId, categoryId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'hubId', 'title', 'description', 'color', 'createdAtLabel', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(categoryId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Study Activity History ---
      match /history/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(entryId)
          && isOwner(userId) && isVerifiedUser()
          && isValidHistoryEntry(incoming(), userId, entryId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(entryId)
          && isOwner(userId) && isVerifiedUser()
          && isValidHistoryEntry(incoming(), userId, entryId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'actionType', 'title', 'detail', 'targetTab',
            'targetNoteId', 'targetMonthId', 'targetCourseId',
            'timestampLabel', 'createdAtMs', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(entryId) && isOwner(userId) && isVerifiedUser();
      }

      // --- User Notes & Voice Customization Preferences ---
      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(prefId)
          && isOwner(userId) && isVerifiedUser()
          && isValidUserPreferences(incoming(), userId, prefId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(prefId)
          && isOwner(userId) && isVerifiedUser()
          && isValidUserPreferences(incoming(), userId, prefId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'noteFontSize', 'noteHighlightColor', 'notePaperTone',
            'autoAddTimestampOnVoice', 'voiceDialect', 'voiceInsertMode',
            'readAloudVoice', 'readAloudSpeed', 'showExcelExport', 'hubCategories', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(prefId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Personal Reflections (خواطري) ---
      match /reflections/{reflectionId} {
        allow get: if isValidId(userId) && isValidId(reflectionId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(reflectionId)
          && isOwner(userId) && isVerifiedUser()
          && isValidReflection(incoming(), userId, reflectionId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(reflectionId)
          && isOwner(userId) && isVerifiedUser()
          && isValidReflection(incoming(), userId, reflectionId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'content', 'moodTag', 'pinned', 'createdAtLabel', 'createdAtMs', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(reflectionId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Personal Weekly/Monthly Calendar Events ---
      match /calendarEvents/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(eventId)
          && isOwner(userId) && isVerifiedUser()
          && isValidCalendarEvent(incoming(), userId, eventId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(eventId)
          && isOwner(userId) && isVerifiedUser()
          && isValidCalendarEvent(incoming(), userId, eventId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'dateKey', 'timeSlot', 'title', 'notes', 'category',
            'color', 'done', 'linkedTaskText', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(eventId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Learning Paths ---
      match /learningPaths/{pathId} {
        allow get: if isValidId(userId) && isValidId(pathId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(pathId)
          && isOwner(userId) && isVerifiedUser()
          && isValidLearningPath(incoming(), userId, pathId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(pathId)
          && isOwner(userId) && isVerifiedUser()
          && isValidLearningPath(incoming(), userId, pathId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'hubId', 'categoryLabel', 'objectives',
            'currentLevel', 'targetLevel', 'startDate', 'expectedCompletionDate',
            'progressPct', 'status', 'stages', 'linkedCourseIds',
            'readingModes', 'learningMethods', 'reviewCount', 'listenCount', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(pathId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Unified Reading & PDF Library ---
      match /readingItems/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(itemId)
          && isOwner(userId) && isVerifiedUser()
          && isValidReadingItem(incoming(), userId, itemId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(itemId)
          && isOwner(userId) && isVerifiedUser()
          && isValidReadingItem(incoming(), userId, itemId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'author', 'hubId', 'categoryLabel', 'itemType',
            'status', 'currentPage', 'totalPages', 'takeaways',
            'attachmentName', 'attachmentResourceId', 'storagePath', 'downloadUrl', 'externalUrl',
            'readingModes', 'learningMethods', 'reviewCount', 'listenCount',
            'repetitionStage', 'nextReviewDateKey', 'lastReviewedDateKey',
            'updatedAtLabel', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Practical Projects ---
      match /projects/{projectId} {
        allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(projectId)
          && isOwner(userId) && isVerifiedUser()
          && isValidPracticalProject(incoming(), userId, projectId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(projectId)
          && isOwner(userId) && isVerifiedUser()
          && isValidPracticalProject(incoming(), userId, projectId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'hubId', 'categoryLabel', 'objectives',
            'status', 'progressPct', 'deliverables', 'startDate', 'targetDate',
            'linkedCourseId', 'notes', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(projectId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Unified Tasks ---
      match /unifiedTasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(taskId)
          && isOwner(userId) && isVerifiedUser()
          && isValidUnifiedTask(incoming(), userId, taskId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(taskId)
          && isOwner(userId) && isVerifiedUser()
          && isValidUnifiedTask(incoming(), userId, taskId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'hubId', 'categoryLabel', 'priority',
            'status', 'dueDate', 'linkedLabel', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Cloud-Synced Image Attachments ---
      match /images/{imageId} {
        allow get: if isValidId(userId) && isValidId(imageId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(imageId)
          && isOwner(userId) && isVerifiedUser()
          && isValidImageAttachment(incoming(), userId, imageId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(imageId)
          && isOwner(userId) && isVerifiedUser()
          && isValidImageAttachment(incoming(), userId, imageId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'scopeKey', 'name', 'mimeType', 'sizeKb', 'caption',
            'dataUrl', 'storagePath', 'downloadUrl', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(imageId) && isOwner(userId) && isVerifiedUser();
      }

      // --- Cloud-Synced File / PDF Attachments ---
      match /attachments/{attachmentId} {
        allow get: if isValidId(userId) && isValidId(attachmentId) && isOwner(userId) && isVerifiedUser();
        allow list: if isValidId(userId) && isOwner(userId) && isVerifiedUser() && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(attachmentId)
          && isOwner(userId) && isVerifiedUser()
          && isValidFileAttachment(incoming(), userId, attachmentId)
          && incoming().updatedAt == request.time
          && userExists(userId);
        allow update: if isValidId(userId) && isValidId(attachmentId)
          && isOwner(userId) && isVerifiedUser()
          && isValidFileAttachment(incoming(), userId, attachmentId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(attachmentId) && isOwner(userId) && isVerifiedUser();
      }
    }
  }
}
