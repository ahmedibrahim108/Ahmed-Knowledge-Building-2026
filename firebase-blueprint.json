{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile stored privately under the user's UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "QuarterItem": {
      "title": "QuarterItem",
      "description": "Editable quarterly phase of the balanced curriculum.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "number", "title", "subtitle", "updatedAt"]
    },
    "MonthItem": {
      "title": "MonthItem",
      "description": "A single month or milestone in the balanced study plan.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "docId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "quarter": {
          "type": "integer"
        },
        "quarterTitle": {
          "type": "string",
          "maxLength": 200
        },
        "theme": {
          "type": "string",
          "maxLength": 250
        },
        "foundational": {
          "type": "object"
        },
        "exploratory": {
          "type": "object"
        },
        "courseId": {
          "type": "integer"
        },
        "discussionPrompt": {
          "type": "string",
          "maxLength": 1000
        },
        "applicationTask": {
          "type": "string",
          "maxLength": 1000
        },
        "activities": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "completed"]
        },
        "notes": {
          "type": "string",
          "maxLength": 20000
        },
        "tasks": {
          "type": "array"
        },
        "resources": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "docId",
        "ownerId",
        "quarter",
        "quarterTitle",
        "theme",
        "foundational",
        "exploratory",
        "courseId",
        "discussionPrompt",
        "applicationTask",
        "activities",
        "status",
        "notes",
        "tasks",
        "resources",
        "updatedAt"
      ]
    },
    "DomainItem": {
      "title": "DomainItem",
      "description": "Intellectual domain and its curated thinkers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "order": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300
        },
        "purpose": {
          "type": "string",
          "maxLength": 1000
        },
        "thinkers": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "order", "title", "subtitle", "purpose", "thinkers", "updatedAt"]
    },
    "CourseItem": {
      "title": "CourseItem",
      "description": "Personal development course linked with complementary references and tasks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "docId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 250
        },
        "category": {
          "type": "string",
          "maxLength": 120
        },
        "linkedMonths": {
          "type": "array"
        },
        "complementaryBook": {
          "type": "string",
          "maxLength": 300
        },
        "bookAuthor": {
          "type": "string",
          "maxLength": 250
        },
        "applicationMilestone": {
          "type": "string",
          "maxLength": 1000
        },
        "completed": {
          "type": "boolean"
        },
        "resources": {
          "type": "array"
        },
        "tasks": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "docId",
        "ownerId",
        "title",
        "category",
        "linkedMonths",
        "complementaryBook",
        "bookAuthor",
        "applicationMilestone",
        "completed",
        "resources",
        "tasks",
        "updatedAt"
      ]
    },
    "BookNoteItem": {
      "title": "BookNoteItem",
      "description": "Structured notes categorized by book, course/lecture, or custom topic.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "noteType": {
          "type": "string",
          "enum": ["book", "course_lecture", "general"]
        },
        "bookTitle": {
          "type": "string",
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "courseId": {
          "type": "integer"
        },
        "courseTitle": {
          "type": "string",
          "maxLength": 250
        },
        "lectureTitle": {
          "type": "string",
          "maxLength": 250
        },
        "categoryLabel": {
          "type": "string",
          "maxLength": 120
        },
        "progressMarker": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 40000
        },
        "quotes": {
          "type": "string",
          "maxLength": 10000
        },
        "updatedAtLabel": {
          "type": "string",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "bookTitle",
        "author",
        "progressMarker",
        "content",
        "quotes",
        "updatedAtLabel",
        "updatedAt"
      ]
    },
    "CustomCategoryItem": {
      "title": "CustomCategoryItem",
      "description": "User-defined personalized category for organizing study notes and dashboard insights.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "color": {
          "type": "string",
          "enum": ["navy", "emerald", "amber", "slate"]
        },
        "createdAtLabel": {
          "type": "string",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "description",
        "color",
        "createdAtLabel",
        "updatedAt"
      ]
    },
    "StudyHistoryItem": {
      "title": "StudyHistoryItem",
      "description": "User study activity history entry synced to dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actionType": {
          "type": "string",
          "enum": ["note", "voice", "task", "course", "domain", "month"]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "maxLength": 400
        },
        "targetTab": {
          "type": "string",
          "enum": ["overview", "plan", "domains", "courses", "journal", "calendar"]
        },
        "targetNoteId": {
          "type": "string",
          "maxLength": 128
        },
        "targetMonthId": {
          "type": "integer"
        },
        "timestampLabel": {
          "type": "string",
          "maxLength": 100
        },
        "createdAtMs": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "actionType",
        "title",
        "detail",
        "targetTab",
        "timestampLabel",
        "createdAtMs",
        "updatedAt"
      ]
    },
    "UserPreferencesItem": {
      "title": "UserPreferencesItem",
      "description": "User customization settings for rich notes formatting and voice transcription/playback.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "noteFontSize": {
          "type": "string",
          "enum": ["sm", "base", "lg"]
        },
        "noteHighlightColor": {
          "type": "string",
          "enum": ["amber", "emerald", "sky", "rose"]
        },
        "notePaperTone": {
          "type": "string",
          "enum": ["clean", "warm", "slate"]
        },
        "autoAddTimestampOnVoice": {
          "type": "boolean"
        },
        "voiceDialect": {
          "type": "string",
          "enum": ["standard_arabic", "egyptian_arabic", "bilingual"]
        },
        "voiceInsertMode": {
          "type": "string",
          "enum": ["append_paragraph", "append_bullet", "append_quote"]
        },
        "readAloudVoice": {
          "type": "string",
          "enum": ["Kore", "Puck", "Charon", "Fenrir", "Zephyr"]
        },
        "readAloudSpeed": {
          "type": "string",
          "enum": ["normal", "calm"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "noteFontSize",
        "noteHighlightColor",
        "notePaperTone",
        "autoAddTimestampOnVoice",
        "voiceDialect",
        "voiceInsertMode",
        "readAloudVoice",
        "readAloudSpeed",
        "updatedAt"
      ]
    },
    "PersonalReflectionItem": {
      "title": "PersonalReflectionItem",
      "description": "User's private personal reflections and study thoughts stored on their dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "moodTag": {
          "type": "string",
          "enum": ["تأمل", "فكرة", "امتنان", "هدف"]
        },
        "pinned": {
          "type": "boolean"
        },
        "createdAtLabel": {
          "type": "string",
          "maxLength": 100
        },
        "createdAtMs": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "content",
        "moodTag",
        "pinned",
        "createdAtLabel",
        "createdAtMs",
        "updatedAt"
      ]
    },
    "CalendarEventItem": {
      "title": "CalendarEventItem",
      "description": "Personal weekly/monthly calendar event with optional task link.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timeSlot": {
          "type": "string",
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": ["شخصي", "دراسة", "موعد", "مراجعة", "قراءة"]
        },
        "color": {
          "type": "string",
          "enum": ["navy", "emerald", "amber", "rose"]
        },
        "done": {
          "type": "boolean"
        },
        "linkedTaskText": {
          "type": "string",
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "dateKey",
        "timeSlot",
        "title",
        "notes",
        "category",
        "color",
        "done",
        "linkedTaskText",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile document."
    },
    "/users/{userId}/quarters/{quarterId}": {
      "schema": { "$ref": "#/entities/QuarterItem" },
      "description": "User's editable quarters."
    },
    "/users/{userId}/months/{monthId}": {
      "schema": { "$ref": "#/entities/MonthItem" },
      "description": "User's editable study plan units."
    },
    "/users/{userId}/domains/{domainId}": {
      "schema": { "$ref": "#/entities/DomainItem" },
      "description": "User's editable intellectual domains and thinkers."
    },
    "/users/{userId}/courses/{courseId}": {
      "schema": { "$ref": "#/entities/CourseItem" },
      "description": "User's editable personal development courses."
    },
    "/users/{userId}/bookNotes/{noteId}": {
      "schema": { "$ref": "#/entities/BookNoteItem" },
      "description": "User's categorized notes for books, course lectures, and topics."
    },
    "/users/{userId}/customCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/CustomCategoryItem" },
      "description": "User's personalized study categories."
    },
    "/users/{userId}/history/{entryId}": {
      "schema": { "$ref": "#/entities/StudyHistoryItem" },
      "description": "User's personalized study activity log."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferencesItem" },
      "description": "User's personal customization for notes editor and voice controls."
    },
    "/users/{userId}/reflections/{reflectionId}": {
      "schema": { "$ref": "#/entities/PersonalReflectionItem" },
      "description": "User's private personal reflections and thoughts on the dashboard."
    },
    "/users/{userId}/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEventItem" },
      "description": "User's personal weekly and monthly calendar schedule events."
    }
  }
}
